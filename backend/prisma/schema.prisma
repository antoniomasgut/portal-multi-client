// ═══════════════════════════════════════════════════════════════════
// Prisma Schema — Portal Multi-Client
// Els models s'afegiran mòdul a mòdul.
// Mòdul 1: User + Role
// Mòdul 2: Client + Plan + ClientUsage + Discounts...
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

