generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuaris i autenticació ────────────────────────────────────────────
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(CLIENT)
  clientId  String?
  lastLogin DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client    Client?   @relation(fields: [clientId], references: [id])

  @@index([email])
  @@index([role])
  @@index([clientId])
  @@map("users")
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@map("magic_link_tokens")
}

// ── Audit log ─────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  clientId   String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  client     Client?  @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Serveis ───────────────────────────────────────────────────────────
model Service {
  id           String  @id @default(uuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  setupPrice   Decimal @default(0) @db.Decimal(10, 2)
  monthlyPrice Decimal @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  planServices         PlanService[]
  subscriptionServices SubscriptionService[]

  @@index([slug])
  @@map("services")
}

// ── Plans de servei ───────────────────────────────────────────────────
model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  priceMonthly Decimal  @db.Decimal(10, 2)
  maxDomains   Int      @default(1)
  maxUsers     Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services      PlanService[]
  subscriptions Subscription[]

  @@index([slug])
  @@map("plans")
}

// ── Plans ↔ Serveis ───────────────────────────────────────────────────
model PlanService {
  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId],    references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([planId, serviceId])
  @@map("plan_services")
}

// ── Clients (empreses) ─────────────────────────────────────────────────
model Client {
  id           String    @id @default(uuid())
  companyName  String
  contactName  String
  contactEmail String    @unique
  contactPhone String?
  nif          String?
  address      String?
  domain       String?   @unique
  logoUrl      String?
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users         User[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]

  @@index([contactEmail])
  @@index([domain])
  @@map("clients")
}

// ── Subscripcions ─────────────────────────────────────────────────────
model Subscription {
  id                 String             @id @default(uuid())
  clientId           String
  planId             String?
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  renewsAt           DateTime?
  cancelledAt        DateTime?
  isCustom     Boolean @default(false)
  priceMonthly Decimal @default(0) @db.Decimal(10, 2)
  priceSetup   Decimal @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt          DateTime           @updatedAt

  client   Client               @relation(fields: [clientId], references: [id])
  plan     Plan?                @relation(fields: [planId],   references: [id])
  services SubscriptionService[]

  @@index([clientId])
  @@index([status])
  @@map("subscriptions")
}

// ── Subscripcions ↔ Serveis ───────────────────────────────────────────
model SubscriptionService {
  subscriptionId String
  serviceId      String
  // isExtra: true = afegit sobre el pla base; false = inclòs al pla
  isExtra        Boolean @default(false)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  service      Service      @relation(fields: [serviceId],      references: [id])

  @@id([subscriptionId, serviceId])
  @@map("subscription_services")
}

// ── Enums ─────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  CLIENT
  VISITOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}
