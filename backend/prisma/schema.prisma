generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuaris i autenticació ────────────────────────────────────────────
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(CLIENT)
  clientId  String?
  lastLogin DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client    Client?   @relation(fields: [clientId], references: [id])

  @@index([email])
  @@index([role])
  @@index([clientId])
  @@map("users")
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
  @@map("magic_link_tokens")
}

// ── Audit log ─────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  clientId   String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  isTest     Boolean  @default(false)
  createdAt  DateTime @default(now())

  client     Client?  @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Serveis ───────────────────────────────────────────────────────────
model Service {
  id           String          @id @default(uuid())
  name         String          @unique
  slug         String          @unique
  description  String?
  category     ServiceCategory @default(PRODUCTE)
  setupPrice   Decimal         @default(0) @db.Decimal(10, 2)
  monthlyPrice Decimal         @default(0) @db.Decimal(10, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  planServices         PlanService[]
  subscriptionServices SubscriptionService[]

  @@index([slug])
  @@index([category])
  @@map("services")
}

enum ServiceCategory {
  PRODUCTE
  IA
  AUTOMATITZACIONS
  COMUNICACIO
  INFORMES
  SUPORT
  OPERACIONAL
}

// ── Plans de servei ───────────────────────────────────────────────────
model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  priceMonthly Decimal  @db.Decimal(10, 2)
  maxDomains   Int      @default(1)
  maxUsers     Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Límits d'ús
  maxConversations Int?
  maxTokens        Int?
  maxAutomations   Int?
  maxIntegrations  Int?
  maxRagDocuments  Int?

  // Funcionalitats
  hasLandingPro   Boolean @default(false)
  hasCustomDomain Boolean @default(false)
  hasRag          Boolean @default(false)
  hasTelegram     Boolean @default(false)

  // Preus excedents
  extraConversationPrice Decimal @default(0.005) @db.Decimal(10, 4)
  extraTokenPrice        Decimal @default(0.0001) @db.Decimal(10, 6)

  services      PlanService[]
  subscriptions Subscription[]

  @@index([slug])
  @@map("plans")
}

// ── Plans ↔ Serveis ───────────────────────────────────────────────────
model PlanService {
  planId    String
  serviceId String

  plan    Plan    @relation(fields: [planId],    references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([planId, serviceId])
  @@map("plan_services")
}

// ── Clients (empreses) ─────────────────────────────────────────────────
model Client {
  id           String       @id @default(uuid())
  companyName  String
  contactName  String
  contactEmail String       @unique
  contactPhone String?
  nif          String?
  address      String?
  domain       String?      @unique
  logoUrl      String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  billingType  BillingType  @default(MONTHLY)
  language     String       @default("ca")
  referralCode String?      @unique
  referredById String?
  isTest       Boolean      @default(false)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  referredBy    Client?       @relation("Referrals", fields: [referredById], references: [id])
  referrals     Client[]      @relation("Referrals")
  users         User[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  usage         ClientUsage?
  discounts     ClientDiscount[]
  planHistory   PlanHistory[]
  credentials   ClientCredential[]
  oauthStates   OAuthState[]
  invoices      Invoice[]
  landing       ClientLanding?

  @@index([contactEmail])
  @@index([domain])
  @@index([referralCode])
  @@map("clients")
}

// ── Subscripcions ─────────────────────────────────────────────────────
model Subscription {
  id                 String             @id @default(uuid())
  clientId           String
  planId             String?
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  renewsAt           DateTime?
  cancelledAt        DateTime?
  isCustom     Boolean @default(false)
  priceMonthly Decimal @default(0) @db.Decimal(10, 2)
  priceSetup   Decimal @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt          DateTime           @updatedAt

  client   Client               @relation(fields: [clientId], references: [id])
  plan     Plan?                @relation(fields: [planId],   references: [id])
  services SubscriptionService[]

  @@index([clientId])
  @@index([status])
  @@map("subscriptions")
}

// ── Subscripcions ↔ Serveis ───────────────────────────────────────────
model SubscriptionService {
  subscriptionId String
  serviceId      String
  // isExtra: true = afegit sobre el pla base; false = inclòs al pla
  isExtra        Boolean   @default(false)
  // active: el servei ha estat configurat i activat per l'administrador
  active         Boolean   @default(false)
  activatedAt    DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  service      Service      @relation(fields: [serviceId],      references: [id])

  @@id([subscriptionId, serviceId])
  @@map("subscription_services")
}

// ── Ús del client (reinicia cada mes) ────────────────────────────────
model ClientUsage {
  id                String   @id @default(uuid())
  clientId          String   @unique
  conversationsUsed Int      @default(0)
  tokensUsed        Int      @default(0)
  automationsUsed   Int      @default(0)
  ragDocsUsed       Int      @default(0)
  periodStart       DateTime @default(now())
  periodEnd         DateTime
  updatedAt         DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@map("client_usage")
}

// ── Historial de plans ────────────────────────────────────────────────
model PlanHistory {
  id        String   @id @default(uuid())
  clientId  String
  planId    String?
  planName  String
  price     Decimal  @db.Decimal(10, 2)
  reason    String?
  changedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("plan_history")
}

// ── OAuth State (CSRF tokens per als fluxos d'autorització) ──────────
model OAuthState {
  id         String   @id @default(uuid())
  state      String   @unique
  clientId   String
  provider   String   // ex: "whatsapp", "google"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([state])
  @@index([clientId])
  @@map("oauth_states")
}

// ── Credencials de clients (encriptades AES-256-GCM) ─────────────────
model ClientCredential {
  id           String   @id @default(uuid())
  clientId     String
  service      String   // ex: "whatsapp", "n8n", "openai"
  key          String   // ex: "API_KEY", "PHONE_ID", "WEBHOOK_URL"
  encryptedVal String
  iv           String
  tag          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, service, key])
  @@index([clientId])
  @@map("client_credentials")
}

// ── Polítiques de descompte ───────────────────────────────────────────
model DiscountPolicy {
  id             String       @id @default(uuid())
  type           DiscountType @unique
  isActive       Boolean      @default(true)
  percentage     Decimal?     @db.Decimal(5, 2)
  monthsFree     Int?
  durationMonths Int?
  description    String?
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("discount_policies")
}

// ── Descomptes aplicats a clients ─────────────────────────────────────
model ClientDiscount {
  id         String       @id @default(uuid())
  clientId   String
  type       DiscountType
  percentage Decimal?     @db.Decimal(5, 2)
  monthsFree Int?
  appliedAt  DateTime     @default(now())
  expiresAt  DateTime?
  isActive   Boolean      @default(true)
  reason     String?
  appliedBy  String?

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("client_discounts")
}

// ── Factures ──────────────────────────────────────────────────────────
model Invoice {
  id          String        @id @default(uuid())
  clientId    String
  number      String        @unique  // ex: "2026-0001"
  status      InvoiceStatus @default(PENDING)
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  subtotal    Decimal       @db.Decimal(10, 2)
  discountAmt Decimal       @default(0) @db.Decimal(10, 2)
  taxRate     Decimal       @default(21) @db.Decimal(5, 2)
  taxAmt      Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  notes       String?
  paidAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ── Micro-Landing dels clients ────────────────────────────────────────
model ClientLanding {
  id           String   @id @default(uuid())
  clientId     String   @unique
  title        String
  subtitle     String?
  description  String?
  ctaText      String   @default("Contacta'ns")
  ctaUrl       String?
  logoGcsPath  String?
  logoUrl      String?  // URL pública (GCS o externa) o base64 data URL (MVP)
  primaryColor String   @default("#FF6B00")
  style        String   @default("dark-tech")
  fontPair     String   @default("orbitron-rajdhani")
  published    Boolean  @default(false)
  publishedAt  DateTime?
  slug         String   @unique  // ex: "empresa-amg" → /l/empresa-amg
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client       Client   @relation(fields: [clientId], references: [id])

  @@index([slug])
  @@map("client_landings")
}

// ── Política global de preus ──────────────────────────────────────────
model PricingPolicy {
  id                    String   @id @default(uuid())
  minNoticeDays         Int      @default(30)
  allowImmediateChange  Boolean  @default(false)
  notifyClientsOnChange Boolean  @default(true)
  updatedBy             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("pricing_policies")
}

// ── Enums ─────────────────────────────────────────────────────────────
enum Role {
  ADMIN
  CLIENT
  VISITOR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum BillingType {
  MONTHLY
  ANNUAL
}

enum DiscountType {
  NEW_CLIENT
  ANNUAL_PAYMENT
  REFERRAL_REFERRER
  REFERRAL_NEW
  MANUAL
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}
