# ═══════════════════════════════════════════════════════════════════
# .env.example — Portal Multi-Client
# Copia a .env i omple amb les teves credencials reals.
# MAI commetis el fitxer .env al repositori.
# ═══════════════════════════════════════════════════════════════════

# ── Base de dades ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db:5432/portal_db

# ── JWT (generar amb: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=canvia_aquest_secret_jwt_molt_llarg_i_segur
JWT_REFRESH_SECRET=canvia_aquest_secret_refresh_molt_llarg_i_segur

# ── Encriptació de credencials dels clients (AES-256-GCM) ────────────
# Generar amb: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── IA (configurable per fase) ────────────────────────────────────────
# Fase 1: tot via Groq API
# Fase 2+: quality=groq (landings), fast=local (RAG + automatitzacions)
IA_PROVIDER_QUALITY=groq
IA_PROVIDER_FAST=groq
IA_PROVIDER_LOCAL=none
MODEL_QUALITY=llama-3.3-70b
MODEL_FAST=llama-3.1-8b
MODEL_LOCAL=gemma3:4b

GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://ai:11434
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=portal_rag

# ── Email (Mailtrap per proves / SMTP real en producció) ─────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AMG Enginyeria Digital <noreply@amgdigital.es>
PORTAL_URL=http://localhost:3000

# ── n8n ────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=canvia_aquest_password_n8n
N8N_WEBHOOK_SECRET=canvia_aquest_secret_webhook
N8N_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=canvia_aquest_api_key_n8n
N8N_ENCRYPTION_KEY=canvia_aquest_encryption_key_n8n

# ── Dominis ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:3000
DOMAIN_BASE=localhost
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Google Cloud Storage ──────────────────────────────────────────────
GCS_BUCKET_NAME=portal-multi-client-bucket
GCS_PROJECT_ID=el-teu-project-id
GCS_KEY_FILE=./gcs-credentials.json
# → Descarregar gcs-credentials.json des de Google Cloud Console

# ── Rate limiting ──────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5
